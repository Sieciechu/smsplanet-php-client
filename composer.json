{
    "name": "smsplanet/smsplanet-php-client",
    "description": "Klient SMS API napisany w języku PHP, pozwalający na wysyłanie wiadomości SMS, MMS oraz korzystanie z innych funkcji dostępnych w serwisie SMSPLANET.pl",
    "homepage": "https://github.com/smsplanetpl/smsplanet-php-client",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "api client",
        "sms",
        "mms",
        "smsplanet",
        "smsplanet.pl"
    ],
    "authors": [
        {
            "name": "Paweł Feruś",
            "email": "pawel.ferus@agsystems.pl"
        },
        {
            "name": "Krzysztof Gwiazda",
            "email": "krzysztof.gwiazda@agsystems.pl"
        },
        {
            "name": "Sergij Lebedyn",
            "email": "sergiusz.lebedyn@otostolik.pl"
        }
    ],
    "require": {
        "php": "^8.3",
        "ext-dom": "*",
        "ext-simplexml": "*",
        "ext-fileinfo": "*",
        "guzzlehttp/guzzle": "^7.9 || ^8.0",
        "guzzlehttp/psr7": "^2.0 || ^3.0",
        "nesbot/carbon": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "SMSPLANET\\PHP\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SMSPLANET\\PHP\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "vlucas/phpdotenv": "^5.6"
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
